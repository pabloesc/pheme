<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mlops.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/pabloescobardelaoliva/pheme/run_daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/pabloescobardelaoliva/pheme</string>

    <!-- Local time (Europe/Madrid). If the Mac is asleep, launchd runs it on next wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/pabloescobardelaoliva/pheme/newsletter.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/pabloescobardelaoliva/pheme/newsletter.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
