# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (DALL-E 3 image generation) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_...

# Daily sender — use sandbox while testing (delivers only to your own verified email)
RESEND_FROM=Pheme <onboarding@resend.dev>

# Daily recipient (required). With the sandbox sender this must be the email on your Resend account.
RESEND_TO=you@example.com

# Weekly recipient (optional) — defaults to RESEND_TO
RESEND_TO_WEEKLY=

# Weekly sender — requires a verified domain in Resend
# Leave blank to compile the digest locally without sending
RESEND_FROM_WEEKLY=Pheme Weekly <weekly@yourdomain.com>

# Resend Audience ID for weekly recipients — created via: python subscribers.py init
RESEND_AUDIENCE_ID=

# ── Local mode (LM Studio) ─────────────────────────────
# LLM_PROVIDER=local                   # anthropic (default) | local
# LLM_BASE_URL=http://localhost:1234/v1  # use the port shown in LM Studio's server tab
# LLM_MODEL=qwen/qwen3.6-35b-a3b       # must match the model id in LM Studio
# LLM_CONTEXT_LENGTH=32768             # only used if Pheme has to load the model
# LLM_MAX_TOKENS=16384                 # reasoning tokens count toward this
# LLM_UNLOAD_AFTER=false               # true = unload the model after each run
# LMS_PATH=                            # lms CLI; auto-detected (~/.lmstudio/bin/lms)

# Header image: openai (DALL-E 3, default) | none
# IMAGE_PROVIDER=none

# GitHub personal access token (optional but recommended — raises rate limit from 60 to 5000 req/hr)
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=
