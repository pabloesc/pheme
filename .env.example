# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (DALL-E 3 image generation) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_...

# Daily sender — use sandbox while testing (delivers only to your own verified email)
RESEND_FROM=Pheme <onboarding@resend.dev>

# Weekly sender — requires a verified domain in Resend
# Leave blank to compile the digest locally without sending
RESEND_FROM_WEEKLY=Pheme Weekly <weekly@yourdomain.com>

# Resend Audience ID for weekly recipients — created via: python subscribers.py init
RESEND_AUDIENCE_ID=

# GitHub personal access token (optional but recommended — raises rate limit from 60 to 5000 req/hr)
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=
